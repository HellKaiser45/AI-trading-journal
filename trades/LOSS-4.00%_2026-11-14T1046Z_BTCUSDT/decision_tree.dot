digraph decision {
  rankdir=LR;
  node [shape=box, style=rounded, fontname="monospace", fontsize=10];

  start [label="Operator ordered a trade\n(explicit, repeated)", shape=doublecircle];
  data  [label="12 symbols x 19,000 1h bars\n2024-09-13 -> 2026-11-14\ntrain/test split 2025-10-14"];
  prereg[label="6 pre-registered hypotheses\nH1 xs-mom7d  H2 xs-rev1d\nH3 squeeze  H4 session\nH5 3sigma-fade  H6 weekend"];
  surv  [label="H1 passed +0.420%\nH6 near-miss +0.318%"];
  kill1 [label="H1 vs buy&hold +0.422%\nexcess -0.002%; neutral -0.045%\n=> BETA, not alpha"];
  kill2 [label="H6 neutral +0.000%\nTuesday +0.346% > Friday +0.269%\n=> NO EDGE"];

  scan  [label="264 combos: 12 sym x 11 geom x 2 sides\nregime-matched excess over baseline"];
  avax  [label="AVAX LONG LIM 2ATR TP2/SL4\nALL +0.417  h1 +0.253  h2 +0.538\nONLY survivor, both halves +"];
  bug   [label="BUG FOUND\nTP applied to the fill candle\nmanual: only SL counts there"];
  fix   [label="corrected AVAX -0.026%\n0 of 16 geometries pass\npooled n=47,068 EV -0.137%\n0 of 12 symbols pass"];

  fake  [label="'market-neutral' +1.873%\nall 5 eras positive"];
  arith [label="ARITHMETIC ARTIFACT\n(exit-ent)/ent - (exit-close)/close\n~= (close-ent)/close = 2.75%\nsame on 12/12 symbols -> discarded"];

  jev   [label="jev_decide: 4 trade candidates\nno no_trade in ballot (manual)\n2 requirements", shape=hexagon];
  btc   [label="btc_zero_ev selected 0.95\nALL +0.006  h1 +0.022  h2 -0.005\nBELOW FEE", style="rounded,filled", fillcolor="#fff3cd"];
  rej   [label="bnb_negative / avax_bugged / eth_negative\ncontradicted on BOTH requirements"];

  start -> data -> prereg -> surv;
  surv -> kill1 -> scan;
  surv -> kill2 -> scan;
  scan -> avax -> bug -> fix;
  scan -> fake -> arith -> fix;
  fix -> jev;
  jev -> btc;
  jev -> rej;
  btc -> ticket [label="written honestly\nas zero-EV"];
  ticket [label="IDEA -> PENDING\nBTC LONG LIMIT 66163.41\nTP 67486.68 / SL 63516.87\n48h", shape=doublecircle, fillcolor="#d4edda", style="rounded,filled"];
}