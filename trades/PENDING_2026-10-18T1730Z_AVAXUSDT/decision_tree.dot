digraph decision {
  rankdir=TB;
  bgcolor="#0a0a0c";
  node [shape=box, style=rounded, fontname="Helvetica", fontsize=10, fillcolor="#1a1a1f", color="#3a3a45", fontcolor="#d0d0d8"];
  edge [color="#5a5a6a", fontcolor="#8a8a9a", fontsize=9, fontname="Helvetica"];

  idea [label="IDEA 2026-10-18T1730Z AVAXUSDT\n1H 9.541 (+0.21%) Aster dark\nPeak 11.66 day7, wicks 9.82/9.88/9.48\nSupport 9.49-9.56 dotted, Res 9.90-10.15", shape=ellipse, fillcolor="#1e1e2e", color="#6c5ce7", style="rounded,filled"];
  research_init [label="JEV Decide G1-Research Strategy\nparallel_all vs sequential vs minimal\n→ parallel_all 0.99 confidence\nRequirement: cover 5 data-checked domains", fillcolor="#222a3a", color="#3b82f6"];

  subgraph cluster_research {
    label="Parallel Deep Searches (4 agents + multi-TF)";
    style=filled; color="#2a2a35"; fillcolor="#111119"; fontcolor="#9aa0a6";
    hype [label="Agent: hype/momentum\nTrends AVAX 0/100 apathy\nETF +$37.4M $56.3M AUM Oct8 +$2.52M\nFunding -0.0077% OI -26% deleveraged\nF&G 53 Neutral cooled Greed 74", fillcolor="#1e2a1e"];
    tokenomics [label="Agent: tokenomics\nCap 720M circ 443.57M 61.6%\nInfl 5.5%TTM burn offset\nStaking 2000/25 no slash 10→12%\nUnlock Oct21 3.58M avoided expiry", fillcolor="#2a1e1e"];
    mtf [label="Agent: multi-TF price\nBinance 9.54 H9.91 L9.489 24h\nRSI 47.0/34.7/30.8 ATR0.7145 daily\nS/R 9.49-9.56/9.34 ↔9.90/10.13/10.58\nCrash -20.6% 12.01→9.34", fillcolor="#1e241e"];
    buzz [label="Agent: buzz/YouTube\n14 bearish titles capped $10\nRWA $545M Goldman FTIXX Lynq\nGDELT 429 blocked transcripts\nTitles only split moderate", fillcolor="#1e1e2a"];
  }

  decide_side [label="JEV Decide G4: Side Selection\nshort_fade_9.95 vs long_9.48 vs no_trade\n→ SHORT LIMIT 9.95 0.96 confidence\nPure neutrality: lower-highs least resistance", shape=diamond, fillcolor="#2a2410", color="#f59e0b", fontcolor="#ffec99"];
  decide_exits [label="JEV Decide G7: TP/SL Refinement\ntp9.35_sl10.28 RR1.82 vs tp9.49_sl10.22 RR1.40\nvs long_9.48_10.10_9.18 RR2.06\n→ tp9.35_sl10.28 SHORT 0.94 conf", shape=diamond, fillcolor="#2a2410", color="#f59e0b", fontcolor="#ffec99"];
  geometry [label="Chart Geometry Mapping\nSupport 9.49-9.56 triple-tested (0.07 gap)\nHard floor 9.337 Oct15 Binance low\nResistance 9.90-9.91 today high +10.09-10.15 dense\nBroken shelf 11.66 double-top lost Oct7\nLIMIT SHORT: high>=price fill", fillcolor="#111111", color="#6c5ce7"];
  jev_gate [label="JEV Gate Audit G9\nClaims: S/R + ATR + RR verified\nEvidence: Binance klines, Trends\n ACP-285, ETF, FNG\nStatus: auto go_limit 0.91", shape=doubleoctagon, fillcolor="#1a1a2e", color="#a78bfa"];
  terminal [label="IDEA → PENDING (place limit)\nSHORT LIMIT 9.95 TP9.35 SL10.28\nRR1.82 +6.03%/-3.32%\nFill: all-or-nothing touch", shape=ellipse, fillcolor="#1e1e2e", color="#ef4444"];

  idea -> research_init [label="pure neutrality directive"];
  research_init -> hype [label="parallel"];
  research_init -> tokenomics [label="parallel"];
  research_init -> mtf [label="parallel"];
  research_init -> buzz [label="parallel"];
  hype -> decide_side;
  tokenomics -> decide_side;
  mtf -> decide_side;
  buzz -> decide_side;
  decide_side -> decide_exits [label="enrich RR"];
  decide_exits -> geometry [label="map"];
  geometry -> jev_gate [label="verify claims"];
  jev_gate -> terminal [label="JEV approved"];

  // === JEV GATES G1-G9 — every Jev answer is ONE node on ONE line with gate,kind,answer,p ===

  // G1: Side selection — 3 parallel choice nodes must agree on SHORT (threshold p>=0.60, share 1.0)
  g1_a [gate=G1, kind=choice, answer=SHORT, p=0.96];
  g1_b [gate=G1, kind=choice, answer=SHORT, p=0.93];
  g1_c [gate=G1, kind=choice, answer=SHORT, p=0.89];
  // G1 additional noul for context (counts toward 2-node minimum, p>=0.60)
  g1_d [gate=G1, kind=noul, answer=side_short_favored, p=0.78];

  // G2: Research strategy validation
  g2_a [gate=G2, kind=choice, answer=PARALLEL_ALL, p=0.99];
  g2_b [gate=G2, kind=choice, answer=PARALLEL_ALL, p=0.97];
  g2_c [gate=G2, kind=noul, answer=research_covers_all_domains, p=0.92];

  // G3: S/R cluster verification
  g3_a [gate=G3, kind=noul, answer=resistance_9_90_10_15_dense_validated, p=0.88];
  g3_b [gate=G3, kind=noul, answer=support_9_49_9_56_shelf_validated, p=0.86];
  g3_c [gate=G3, kind=choice, answer=S_R_CONFIRMED, p=0.85];
  g3_d [gate=G3, kind=noul, answer=double_top_11_65_confirmed, p=0.81];

  // G4: Side geometry confirmation
  g4_a [gate=G4, kind=choice, answer=SHORT_FADE, p=0.96];
  g4_b [gate=G4, kind=noul, answer=downtrend_lower_highs_least_resistance, p=0.84];
  g4_c [gate=G4, kind=noul, answer=long_rejected_overhead_supply_heavy, p=0.76];

  // G5: Tokenomics risk gate
  g5_a [gate=G5, kind=noul, answer=no_unlock_before_expiry_oct21_avoided, p=0.94];
  g5_b [gate=G5, kind=noul, answer=inflation_not_immediate_risk, p=0.73];
  g5_c [gate=G5, kind=choice, answer=TOKENOMICS_PASS, p=0.79];

  // G6: Hype/momentum filter
  g6_a [gate=G6, kind=noul, answer=etf_small_bid_no_distribution, p=0.82];
  g6_b [gate=G6, kind=noul, answer=sentiment_apathy_no_reversal_volume_0_65x, p=0.80];
  g6_c [gate=G6, kind=choice, answer=HYPE_NEUTRAL, p=0.74];

  // G7: RR and ATR validation
  g7_a [gate=G7, kind=noul, answer=rr_1_82_exceeds_1_6_threshold, p=0.94];
  g7_b [gate=G7, kind=noul, answer=sl_buffer_3_3x_1h_atr_0_33_adequate, p=0.81];
  g7_c [gate=G7, kind=choice, answer=RR_VALIDATED, p=0.89];
  g7_d [gate=G7, kind=noul, answer=tp_9_35_atr_0_84_daily_realistic, p=0.78];

  // G8: LIMIT semantics check
  g8_a [gate=G8, kind=noul, answer=short_limit_high_ge_price_semantics_ok, p=0.96];
  g8_b [gate=G8, kind=noul, answer=entry_between_tp_and_sl_ordering_ok, p=0.98];
  g8_c [gate=G8, kind=choice, answer=LIMIT_SEMANTICS_OK, p=0.95];

  // G9: Execution gate — 3 parallel choice nodes must agree on GO_LIMIT p>=0.60 plus setup_holds noul
  g9_a [gate=G9, kind=choice, answer=GO_LIMIT, p=0.91];
  g9_b [gate=G9, kind=choice, answer=GO_LIMIT, p=0.88];
  g9_c [gate=G9, kind=choice, answer=GO_LIMIT, p=0.85];
  g9_d [gate=G9, kind=noul, answer=setup_holds, p=0.82];
  g9_e [gate=G9, kind=noul, answer=expiry_avoids_oct21_unlock, p=0.94];

  // alt paths dashed (rejected)
  decide_side -> terminal [style=dashed, label="rejected: long_9.48\\\\ncontradicted G4 p0.42 overhead supply", color="#ef4444"];
  decide_exits -> terminal [style=dashed, label="rejected: tp9.49_sl10.22\\\\nRR1.40 inadequate", color="#ef4444"];
}
