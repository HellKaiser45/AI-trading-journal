  // 8. Rejected Alternatives
  rejected_alts [
    label="Rejected Alternatives\n• LONG LIMIT @ 1122.00 (TP 1158, SL 1102): rejected (jev_noul p=0.32; 30d downtrend & 61.7% taker-sell breakdown)\n• SHORT MARKET @ 1132.74 (TP 1085, SL 1161): rejected (jev_noul p=0.20; oversold 15m RSI 30.13 & RR 1.69)\n• SHORT LIMIT @ 1142.50 / 1160.00: rejected in favor of 1151.00 (front-running 322 ZEC ask wall at 1153.26)\n• Expiry 2026-10-20T00:00Z (too tight, p=0.00) & 21:00Z (exposed to Oct 20 NU7 height announcement, p=0.00)",
    fillcolor="#2a1818", color="#ef4444"
