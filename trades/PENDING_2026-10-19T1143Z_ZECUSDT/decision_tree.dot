  // 9. Final Terminal Action
  terminal [
    label="FINAL DECISION: GO_LIMIT (PENDING)\nZECUSDT SHORT LIMIT @ 1151.00\nTP 1105.00 (+4.00%) | SL 1172.00 (-1.82%) | RR 2.19\nExpire: 2026-10-20T12:00:00Z\nFolder: PENDING_2026-10-19T1143Z_ZECUSDT",
    shape=ellipse, fillcolor="#1e293b", color="#eab308", fontcolor="#fef08a"
