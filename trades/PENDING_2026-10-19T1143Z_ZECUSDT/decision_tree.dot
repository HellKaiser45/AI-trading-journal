  dir_gate [
    label="6. Direction Gate — Parallel Shuffled Calls {LONG, SHORT, NO_TRADE}\nBatch A (Multi-TF State):\n• dir_sym_1 {LONG, SHORT, NO_TRADE}: SHORT p=0.65 (NO_TRADE 0.31, LONG 0.04)\n• dir_sym_2 {SHORT, NO_TRADE, LONG}: SHORT p=0.70 (NO_TRADE 0.28, LONG 0.02)\n• dir_sym_3 {NO_TRADE, LONG, SHORT}: SHORT p=0.64 (NO_TRADE 0.31, LONG 0.05)\nBatch B (Full Round 1-3 State + Symmetric Candidate Setups):\n• dir_final_1 {LONG, SHORT, NO_TRADE}: SHORT p=0.80 (NO_TRADE 0.14, LONG 0.06)\n• dir_final_2 {SHORT, NO_TRADE, LONG}: SHORT p=0.85 (NO_TRADE 0.13, LONG 0.02)\n• dir_final_3 {NO_TRADE, LONG, SHORT}: SHORT p=0.74 (NO_TRADE 0.23, LONG 0.03)\n→ 100% agreement on SHORT with all p >= 0.60",
    shape=diamond, fillcolor="#2d1b24", color="#f43f5e"
