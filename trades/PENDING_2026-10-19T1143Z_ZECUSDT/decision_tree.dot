  // 4. Jev Probability Curves & Structural Propositions
  prob_curves [
    label="4. Jev Noul Probability Curves & Structural Checks\n• Resistance encountered in 1142.50–1160.00 zone: p=0.83\n• Clean breakout above 1163.29 (50d MA) & 1175.07: p=0.12 (unlikely)\n• 24h reject below 1158.77–1163.29 & revisit <=1120.32: p=0.76\n• 24h hold >1118.00 & reclaim 1167.58 (opposite): p=0.22\n• SHORT LIMIT edge (1143–1155 → 1110–1120.50): p=0.72\n• LONG LIMIT edge (1120.50–1126 → 1154–1158): p=0.50\n• SHORT LIMIT superior to SHORT MARKET at 1132.74: p=0.66 (opposite p=0.20)\n• SHORT LIMIT @ 1151.00 fills & rejects before SL 1172.00: p=0.65 (vs @ 1148.00 p=0.54)\n• SL @ 1172.00 (>1158.77 neckline, 50d MA 1163.29, 1170.65 high): p=0.73\n• TP @ 1105.00 (above 0.618 Fib 1103.64) vs 1085.00: p=0.81 (vs 1112.00 p=0.56)",
    fillcolor="#1f242d", color="#38bdf8"
