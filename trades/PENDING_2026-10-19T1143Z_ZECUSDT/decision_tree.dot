digraph decision_tree {
  rankdir=TB;
  bgcolor="#0d0e12";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#181a20", color="#343846", fontcolor="#e2e8f0"];
  edge [color="#64748b", fontcolor="#94a3b8", fontsize=9, fontname="Helvetica"];

  // 1. Chart Extraction & Structure Node
  chart_extract [
    label="1. Chart Extraction (261019_13h41m35s_screenshot.png)\nZECUSDT · 15m · Aster · Close 1132.74 (2026-10-19T11:41:34Z)\n189 points extracted (2026-10-17T12:30Z to 2026-10-19T11:30Z)\n• Left lower highs: 1174.09 → 1160.99 → 1153.30 → 1138.20 → 1132.75\n• 6-touch horizontal support band: 1120.32–1127.56\n• Oct 18 breakdown → V-bottom low 1052.50 (19:30Z)\n• V-reversal impulse: +133.88 USD (+12.72%) in 6.5h to 1186.38 (02:00Z)\n• Upper distribution shelf: 1186.38 → 1175.07 → 1167.58 → 1170.65\n• Broken neckline 1158.77–1160.27 at 10:00Z (-38.29 USD to 1132.36)\n• Fibs (1052.50→1186.38): 0.236=1154.78, 0.382=1135.24, 0.500=1119.44, 0.618=1103.64\n• Chart RSI-14: 15m=30.13 (oversold), 1H=46.80",
    fillcolor="#1e293b", color="#3b82f6"
  ];

  // 2. Scenario Generation & Ranking Loop
  scenario_loop [
    label="2. Scenario Generation & Jev Exhaustion Loop\n• Initial S1–S4 → Jev noul another_plausible p=0.80\n• Added S5 → Jev noul another_plausible p=0.68\n• Added S6, S7 → Jev noul another_plausible p=0.61\n• Added S8 → Jev noul another_plausible p=0.44 (<0.60 → STOP)\n\nJev Rerank (Chart + Research, 8 Scenarios):\n1. S1_short_pullback_1145_to_1105 (score=0.95) [SELECTED]\n2. S2_long_support_1122_to_1158 (score=0.92)\n3. S4_range_chop_1120_1158 (score=0.91)\n4. S8_bull_trap_above_1160_then_drop (score=0.91)\n5. S6_long_trend_breakout_1186 (score=0.90)\n6. S5_long_deep_0618_retrace_1104 (score=0.88)\n7. S7_short_full_roundtrip_1052 (score=0.72)\n8. S3_short_immediate_breakdown (score=0.66)",
    fillcolor="#1e1b4b", color="#8b5cf6"
  ];

  // 3. Multi-Round Research
  research_rounds [
    label="3. Multi-Round Research & Exchange API Verification\n• Jev noul: research_could_change_decision p=0.88, check_1132_feed p=0.82\n• Round 1 (agent_RESEARCH: 10 searches, 18 web + 15 API fetches):\n  - Resolved 1132.74 as 11:15Z-11:30Z close; live bounced to 1142.64–1151.08\n  - 30d trend -25.73% (-26.64% vs BTC) from 1698.00 peak; 50d MA = 1163.29\n  - Binance OI fell -3.4% (474,608→457,633 ZEC) on V-bounce (short-covering)\n  - Oct 20 NU7 ZIP-259 activation-height decision; Oct 18 Sprout freeze (22,309 ZEC)\n• Round 2 & 3 (Binance & Aster klines, depth, taker & L/S ratios):\n  - True ATR-14: 15m=8.89, 1H=18.01, 4H=42.54, 1D=113.01 USD\n  - 15m breakdown (10:00Z-11:00Z): 2.8x vol (1,872.1 ZEC/bar), 61.7% taker sell\n  - 3h hourly taker buy/sell ratio < 1.0 (0.9812, 0.8346, 0.9173)\n  - Aster perp depth: 322.013 ZEC ask wall at 1153.26; funding +0.01%/8h\n  - 48h 1H ZEC-BTC correlation = 0.829 (beta 3.80x)",
    fillcolor="#14261c", color="#22c55e"
