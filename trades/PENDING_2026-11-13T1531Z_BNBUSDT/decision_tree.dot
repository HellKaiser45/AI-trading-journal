digraph decision {
  rankdir=TB;
  node [shape=box, style=rounded, fontname="monospace", fontsize=10];
  edge [fontname="monospace", fontsize=9];

  idea [label="IDEA 2026-11-13T1531Z BNBUSDT 1h\nvision read: 12d lower highs, 645-657 shelf broken,\nlast print 632.64, no support visible below"];

  // stage 2 gate
  scope [label="JEV R1 search scope\nbnb_only 0.71 | both 0.21 | price_only 0.04 | no_search 0.00", shape=diamond];
  idea -> scope;

  research [label="research pass (Binance fapi primary)\n3 premises CORRECTED:\n- low was 622.12, not 632.64\n- peak 723.99 on 11-04, not 11-05\n- broad beta, NOT idiosyncratic"];
  scope -> research;

  // stage 3
  learn [label="learning pass, 19 terminal folders\nsum -0.80% | win rate 18.2%\nboth wins: stop beyond structure, never tested\n6 of 9 losses: 1.0-1.5% stop eaten by noise"];
