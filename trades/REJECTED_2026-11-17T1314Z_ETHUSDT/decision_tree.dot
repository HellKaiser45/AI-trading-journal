digraph decision {
  rankdir=TB;
  node [shape=box, fontname="monospace", fontsize=10];
  edge [fontname="monospace", fontsize=9];

  chart [label="ETHUSDT 4h image\n2796 -> 1736 (-37.9%), bounce +9.1%, stall\nspot 1820.58  ATR14 36.91 (2.03%)\nboxpos 54.0%  dd20 -5.01%"];
  chart -> vision;

  vision [label="vision read folded into graphpoints.csv\n88 points, 2026-11-03 -> 2026-11-17T12:00Z"];
  vision -> question;

  question [label="QUESTION\nIs there a state on this series with positive\nexpectancy that is NOT beta to the downtrend?"];
  question -> m1;

  m1 [label="M1 chart's own read: dd + higher low + reclaim\npanel: SHORT +0.771% (n=1441) vs LONG -0.032%\nETH alone: SHORT -0.341% (n=63)\nETH daily: SHORT +1.561%, LONG -0.889%\nsign flips across timeframes"];
  m1 -> m1v [label="REFUTED"];

  m1v [label="not usable in either direction"];
  m1v -> m2;

  m2 [label="M2 short-on-strength: close in top third of 20-bar range\n4h, lim +0.5ATR / TP 4.0 / SL 2.0, hold 72h\nETH n=1227, EV +0.373%/ticket\nunconditional +0.067% -> delta +0.306pp\nera delta 2024 +0.599 / 2025 +0.103 / 2026 +0.574\nbootstrap 95% CI [-0.191,+1.023]  P(EV<=0)=0.099\nmirror LONG -0.468%  gap -0.842pp"];
  m2 -> m2v [label="STRONGEST"];

  m2v [label="but the interval contains zero"];
  m2v -> m3;

  m3 [label="M3 the DAILY mirror of the SAME idea is LONG\n1d top third: 11/12 symbols positive, pooled +0.592%\nvs all-bars +0.253%; CI [-0.652,+0.968] over 45 months\n2022 delta -2.941pp; same idea on 4h LONG -0.468% in all 3 eras"];
  m3 -> m3v [label="CONTRADICTION"];

  m3v [label="one instrument, two timeframes, opposite answers\nno independent tiebreak -> neither is usable"];
  m3v -> mt;

  mt [label="M4 multiple testing, declared\nt5 screened 336 (state x side x geometry)\n72 passed a two-era sign filter = 21.4%\n~25% expected under a pure null"];
  mt -> mtv [label="NOT EVIDENCE"];
  mtv -> live;

  live [label="LIVE BAR CHECK\nboxpos 54.0% < 66% threshold\nthe state that produced every number in M2\nis NOT satisfied on the bar we would place on"];
  live -> jev;

  jev [label="JEV jev_decide  4 candidates, 3 requirements\nwait_for_trigger 0.86  (no requirement contradicted)\nshort_now_market 0.00  (contradicted req 0 and 1)\nshort_limit_above 0.00  (contradicted req 0 and 1)\nlong_daily_candidate 0.00  (contradicted req 2)\nnone 0.14"];
  jev -> noul;

  noul [label="JEV jev_noul\nlooks like top third on live bar   0.30\npositive in every era              0.18\ndistinguishable from zero at 95%   0.31\ndaily LONG and 4h SHORT both usable 0.37\n72h more likely to 1745 than 1900  0.72\nenvelope asymmetric enough         0.49"];
  noul -> verdict;

  verdict [label="DECISION: REJECTED - no ticket\nreason: the state does not fire on the bar,\nand the only state that measured positive\nis contradicted by its own daily mirror", shape=diamond, style=bold];
  verdict -> rejected;

  rejected [label="IDEA -> REJECTED\nno trade.toml\nrecap.md written\nartifact kept for reuse"];
  verdict -> watch [style=dashed, label="if conditions change"];

  watch [label="WATCH CONDITION (not a trade, not placed)\n4h close >= 66% of the 20-bar range (~1848 today)\nthen SHORT limit close+0.5ATR, TP -4.0ATR, SL +2.0ATR, 72h\nmeasured EV +0.373%, P(EV<=0) 0.099, era delta 3 of 3"];

