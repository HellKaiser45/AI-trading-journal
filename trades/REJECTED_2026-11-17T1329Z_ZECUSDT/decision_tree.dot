digraph decision {
  rankdir=TB;
  node [shape=box, style="rounded", fontname="monospace", fontsize=10];
  edge [fontname="monospace", fontsize=9];

  image [label="ZECUSDT 4h chart image\n2796 -> 801.52 (-44.1% from ATH)\nbounce to 951.56, stale high 948.48"];
  readnow [label="read off the image at 13:29Z\nclose 950.41 / 951.56\nbox 900-960, supply 975-1015"];
  fetch [label="DATA: 12,000 4h bars (5.5y)\n+ 4,380-bar second source\nagree to <0.1%"];
  state [label="STATE at 2026-11-17T12Z\ndd20 -32.00%\nbounce off lo20 +18.70%\nclose>SMA20 902.52\nclose<SMA50 974.15\npos 25.1%  ATR 3.45%"];

  image -> readnow -> fetch -> state;

  sig [label="SIGNAL\ndd<=-28% & bounce>=15% & >SMA20 & <SMA50\nfires on 0.117% of 144,000 bars"];
  state -> sig;

  subgraph cluster_tests {
    label="MEASURED, audited fill model";
    t1 [label="LONG -3/+10/-8, 30 bars\npooled 12 sym, 141 fills\nEV/fill +0.820%\nmedian +0.593%  TP51/SL54/EXP36"];
    t2 [label="ZEC alone 17 eps / 16 fills\nEV/fill +2.753%"];
    t3 [label="SHORT MIRROR same bars\npooled +1.991%  <-- BEATS LONG\nZEC +0.868%"];
    t4 [label="per-symbol LONG-SHORT\nlong wins 4/12\nETH -7.91 BNB -7.99 LINK -3.85"];
    t5 [label="adjacent bars +/-1..3\npooled +2.235%  <-- BEATS SIGNAL\nZEC +3.022%"]
    t6 [label="unconditional all bars\nn=98,685  EV/fill -0.092%"];
    t7 [label="daily bootstrap\n78 days, 59% positive\nCI95 [+0.723,+3.872] P(<=0)=0.001"];
    t8 [label="threshold gap over 15 combos\nNEGATIVE in 13 of 15\n-0.129 .. -6.641 pp"];
    t9 [label="ZEC strictness ladder\ndd -20..-40\nSHORT overtakes LONG at -35"];
  }
  sig -> t1; sig -> t2; sig -> t3; sig -> t4; sig -> t5; sig -> t6; sig -> t7; sig -> t8; sig -> t9;

  bug1 [label="BUG 1: 'LONG-SHORT gap' on the same\nforward return = 2 x LONG. Measures\nnothing. All such numbers voided.", color=red];
  bug2 [label="BUG 2: fill-bar TP counted.\nInflated pooled EV +0.820% -> +3.705%.\nRewritten, audited model kept.", color=red];
  bug3 [label="BUG 3: ASTER panel is 2,442 bars,\nnot 12,000. OOS is 11 symbols.", color=red];
  t1 -> bug1; t3 -> bug1; t1 -> bug2; t4 -> bug3;

  jev [label="JEV decide, 2 requirements\n(reject had 1 contradicted,\nlong had BOTH contradicted)\nselected reject_no_edge 0.74\nlong 0.01  short 0.07", shape=diamond];

  t1 -> jev; t2 -> jev; t3 -> jev; t4 -> jev; t5 -> jev; t6 -> jev; t7 -> jev; t8 -> jev; t9 -> jev;
  jev -> verdict;
  verdict [label="REJECTED 2026-11-17T1329Z\nno trade.toml", color=red];

  lesson [label="LESSON: a state that beats the unconditional\nbaseline is not automatically a trade.\nIf the mirror and the neighbouring bars both\npay more, the state carries volatility, not direction."];
  verdict -> lesson;
}