digraph decision {
  rankdir=TB;
  node [shape=box, style="rounded", fontname="monospace", fontsize=10];
  edge [fontname="monospace", fontsize=9];

  made [label="new_trade.py XRPUSDT\n2026-11-17T14:07Z"];
  restart [label="run abandoned before any measurement\nno chart read, no data fetched, no JEV round"];
  made -> restart;

  real [label="analysis redone at 15:05Z\nfolder REJECTED_2026-11-17T1505Z_XRPUSDT\nsee that folder for every number"];
  restart -> real;

  verdict [label="REJECTED 2026-11-17T1407Z\nsuperseded duplicate, no trade.toml", color=red];
  real -> verdict;
}