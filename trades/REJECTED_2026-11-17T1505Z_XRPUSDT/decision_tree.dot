digraph decision {
  rankdir=TB;
  node [shape=box, style="rounded", fontname="monospace", fontsize=10];
  edge [fontname="monospace", fontsize=9];

  image [label="XRPUSDT 1h chart image\n1.2100 -> 0.8977 low -> 0.9771\nbounce +8.8%, 20-bar range 0.9501-0.9793"];
  readnow [label="read off the image at 15:05Z\nclose 0.9771, position 0.976 of range\ndd 8d -12.37%, dd 14d -27.05%\nATR 0.00824, 4h vol z -0.65"];
  image -> readnow;

  fetch [label="DATA: 14 symbols 1h\n69,003 bars (ADA/BNB/BTC/ETH/LTC/TRX/XRP)\n67,109 ZEC, 9,771 ASTER"];
  readnow -> fetch;

  state [label="STATE DEFINITION (declared first)\nclose in top q of W-bar range\nAND close <= D below L-bar high\nentry at NEXT bar open\nsymmetric ATR bracket"];
  fetch -> state;

  subgraph cluster_short {
    label="SHORT at range high, era split, n=1922";
    s1 [label="TP1.0/SL2.0  E3 -0.314"];
    s2 [label="TP2.0/SL3.0  E3 -0.193  all -0.087"];
    s3 [label="TP2.0/SL4.0  E3 -0.186"];
    s4 [label="TP3.0/SL4.0  E3 -0.276"];
    s5 [label="negative in E3 at EVERY geometry", color=red];
  }
  state -> s1; state -> s2; state -> s3; state -> s4; s2 -> s5;

  subgraph cluster_long {
    label="LONG on the identical bars";
    l1 [label="TP2.0/SL3.0  E3 +0.257  E2 -0.431"];
    l2 [label="TP3.0/SL4.0  E3 +0.453  E2 -0.470"];
    l3 [label="positive in E3, negative in E2\nera-unstable the other way", color=orange];
  }
  state -> l1; state -> l2; l1 -> l3; l2 -> l3;

  gate [label="DRAWDOWN GATE SWEEP, SHORT, E3\n-5% +0.093 | -10% +0.164\n-15% -0.193 | -20% -0.287 | -25% -0.273", color=red];
  flip [label="SIGN FLIPS between -10% and -15%\nlive reading -12.37% sits INSIDE the flip\nnot a threshold effect, a noise band", color=red];
  gate -> flip;

  ctl [label="MATCHED CONTROL (same gate, bottom half of range)\nSHORT excess E3: +0.090 / +0.276 / +0.027 / +0.082\nLONG excess TP2/SL3: -0.044, positive 7/14 symbols"];

  real [label="THE ONE STATE WITH A REAL DIRECTION\nflush >=20% + bounce 8-15% + 4h vol z >= 2\nLONG +5.632 vs SHORT -5.955 on identical bars\nCI [+0.50,+22.10], positive in all 3 eras\nLONG ahead 11/14 symbols", color=green];
  nofire [label="DOES NOT FIRE ON THE LIVE BAR\n4h dd is only -0.07%, 4h vol z is -0.65\nno flush, no volume event", color=orange];

  state -> gate;
  gate -> ctl;
  readnow -> nofire;
  real -> nofire;

  bugs [label="BUGS FOUND, ALL VOIDED\n1 t5/t6 adjacency had look-ahead\n2 t9 reused loop var: ZEC indices on XRP\n3 t8 pooled CI repeated means, not events\n4 first SVG draft had two root elements", color=red];
  s2 -> bugs; l2 -> bugs; flip -> bugs;

  jev1 [label="JEV decide round 1 (2 requirements)\nreject_no_ticket 0.84\nshort_at_range_high 0.00  <-- BOTH reqs contradicted\nlong_breakout 0.08\nwait_for_lower_gate 0.07", shape=diamond];
  jev2 [label="JEV decide round 2 (different angle, 5 cands)\nreject 0.68\nshort_at_range_high 0.22  <-- mirror req contradicted\nlong_breakout 0.03", shape=diamond];
  noul [label="JEV noul, 7 propositions\n'tradeable edge exists here' 0.16\n'SHORT is the right side' 0.24\n'LONG is the right side' 0.26\n'no ticket is better' 0.78\n'LONG E3 strong enough to trade' 0.13 - unlikely", shape=diamond];

  ctl -> jev1;
  flip -> jev1;
  bugs -> jev2;
  ctl -> jev2;
  real -> noul;
  nofire -> noul;

  verdict [label="REJECTED 2026-11-17T1505Z\nno trade.toml", color=red];
  jev1 -> verdict; jev2 -> verdict; noul -> verdict;
}