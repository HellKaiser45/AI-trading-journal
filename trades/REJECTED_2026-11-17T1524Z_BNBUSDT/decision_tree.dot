digraph decision {
  rankdir=TB;
  node [shape=box, fontname="monospace", fontsize=10];
  edge [fontname="monospace", fontsize=9];

  // BNBUSDT 1h, evaluated 2026-11-17T15:24Z, live 592.80.
  // Free-form record; no script reads this file.

  st [label="folder was an abandoned stub, already renamed REJECTED\n101-byte chart.svg, 0 data rows,\ntemplate research_log, template dot, no recap.md"];
  read [label="vision read of the supplied image\nhigh 702.00 (9 Nov) -> low 574.00 (15 Nov, -18.2%)\nrecovery to 603.00, then 588.00-600.50 chop\nlive 592.80, -15.5% from high"];

  mirror [label="MIRROR TEST (repository, 1329Z ZEC, 12 symbols, 141 fills)\nLONG +0.820   SHORT +1.991\nbars 1-3 earlier +2.235   unconditional -0.092"];
  gate [label="GATE MONOTONICITY (1505Z XRP)\n-10% paid +0.164   -15% paid -0.193\nBNB at -15.5% is past the flip"];
  flush [label="DIRECTIONAL SETUP (1505Z XRP)\nflush >=20% in 12 bars + 8-15% bounce\n+ volume z >=2 -> LONG +5.632 vs SHORT -5.955\nBNB fails twice: 6-day decline, bounce only +3.3%"];
  own [label="SAME-INSTRUMENT EVIDENCE (13 Nov folder)\nSHORT LIMIT 642.00 never filled\nhighest print after placement 639.29\nmissed by 0.42% over 48h"];

  c1 [label="LONG LIMIT 585.00\nTP 615.00 / SL 568.00 / 72h"];
  c2 [label="LONG MARKET 592.80\nTP 615.00 / SL 576.00 / 72h"];
  c3 [label="SHORT LIMIT 600.00\nTP 575.00 / SL 612.00 / 72h"];
  c4 [label="SHORT MARKET 592.80\nTP 570.00 / SL 606.00 / 72h"];

  jev [label="jev_decide  4 candidates / 3 requirements\nnone 0.97   short_limit_600 0.02\nshort_market 0.01   longs 0.00", shape=diamond];

  out [label="REJECTED\nno ticket written"];

  st -> read;
  read -> mirror;
  read -> gate;
  read -> flush;
  read -> own;
  gate -> c1 [style=dashed, label="past the flip"];
  gate -> c3 [style=dashed, label="past the flip"];
  flush -> c2 [style=dashed, label="not live"];
  flush -> c4 [style=dashed, label="not live"];
  own -> c1 [style=dashed, label="distance kills limits"];
  own -> c3 [style=dashed, label="distance kills limits"];
  mirror -> c2 [label="contradicted"];
  mirror -> c4 [label="contradicted"];
  c1 -> jev; c2 -> jev; c3 -> jev; c4 -> jev;
  jev -> out;

  note [label="declared limits:\nno candle files -> no new backtest\nall statistics second-hand\nreplica read at ~3h, not 1h\nno volume/funding/OI series", shape=note];
  read -> note [style=dotted];
}